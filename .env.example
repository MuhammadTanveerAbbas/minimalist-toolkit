# Minimalist Toolkit environment variables
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# If the project is linked to Vercel, pull the deployed values instead:
#   vercel link
#   vercel env pull .env.local
#
# Rules:
# - .env.local is gitignored. Never commit real secrets.
# - Keys without NEXT_PUBLIC_ are server only. Never expose them to the browser.
# - After changing values in Vercel, redeploy for them to take effect.

# -----------------------------------------------------------------------------
# App and site
# -----------------------------------------------------------------------------
# Used for metadata, the sitemap and the OpenRouter referrer header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (required for auth and every saved record)
# -----------------------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server only. Used by /api/cron/news to write the shared news_items table.
# Supabase Dashboard -> Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Model providers
# -----------------------------------------------------------------------------
# Server only. Groq powers AI Chat, PromptCraft and the left side of the Playground.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Pins a preferred Groq chat model. The app discovers models and falls
# back when the pinned one is unavailable. Example: llama-3.3-70b-versatile
GROQ_MODEL=

# Server only. OpenRouter lists models and runs the right side of the Playground.
# Get a key at https://openrouter.ai/keys
# Visitors can also paste their own key in the Playground UI.
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# AI News (optional)
# -----------------------------------------------------------------------------
# Optional. Raises the GitHub Search API limit from 60 to 5,000 requests per hour.
# GitHub -> Settings -> Developer settings -> Personal access tokens.
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Operations
# -----------------------------------------------------------------------------
# Bearer token for /api/keep-alive and /api/cron/news. Vercel Cron sends it
# automatically when the variable is set. Use a long random string.
CRON_SECRET=

# -----------------------------------------------------------------------------
# Local testing only. Never enable in production.
# -----------------------------------------------------------------------------
# Bypasses the auth guard in middleware.ts so the UI can be inspected without a
# session. Data features still need a real authenticated session.
DISABLE_AUTH_FOR_TEST=false
