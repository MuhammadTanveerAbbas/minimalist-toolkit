# Minimalist Toolkit environment variables
# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# If linked to Vercel, you can pull configured values:
#   vercel link
#   vercel env pull .env.local
#
# Never commit real secrets. .env.local is gitignored.

# -----------------------------------------------------------------------------
# App / site
# -----------------------------------------------------------------------------
# Public site URL used for metadata/sitemap/robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (required for auth and database-backed features)
# -----------------------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# -----------------------------------------------------------------------------
# AI features (PromptCraft generate/enhance and AI chat)
# -----------------------------------------------------------------------------
# Server-side only. Do not prefix with NEXT_PUBLIC_.
GROQ_API_KEY=your_groq_api_key

# Optional: preferred Groq chat model. The app also discovers available models
# and falls back to other supported chat models if needed.
# Good defaults (availability can vary by account/region): llama-3.3-70b-versatile
GROQ_MODEL=
# -----------------------------------------------------------------------------
# Operations (optional)
# -----------------------------------------------------------------------------
# Used by /api/keep-alive: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your_cron_secret

# -----------------------------------------------------------------------------
# Local testing only (never enable in production)
# -----------------------------------------------------------------------------
# Bypasses auth checks in proxy.ts for local UI testing.
# Features that require a real authenticated session/database access may still fail.
DISABLE_AUTH_FOR_TEST=false
